{
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/privacy-block.cjs\"",
						"commandWindows": "node -e \"require(require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/.codex/hooks/privacy-block.cjs')\"",
						"timeout": 10,
						"statusMessage": "Privacy guard (sensitive files)"
					},
					{
						"type": "command",
						"command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-ship.cjs\"",
						"commandWindows": "node -e \"require(require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/.codex/hooks/pre-ship.cjs')\"",
						"timeout": 300,
						"statusMessage": "Ship check (lint, related tests, type-check)"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/completion-check.cjs\"",
						"commandWindows": "node -e \"require(require('node:child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8'}).trim()+'/.codex/hooks/completion-check.cjs')\"",
						"timeout": 15,
						"statusMessage": "Plan state sync"
					}
				]
			}
		]
	}
}
