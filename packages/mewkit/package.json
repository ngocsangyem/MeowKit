{
  "name": "mewkit",
  "version": "2.3.1",
  "description": "MeowKit CLI — scaffold, upgrade, and manage your AI agent toolkit",
  "type": "module",
  "bin": {
    "mewkit": "./dist/index.js"
  },
  "files": [
    "dist",
    "!dist/maintainer",
    "portable-manifest.json"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:cli",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('tsconfig.tsbuildinfo',{force:true})\"",
    "build:cli": "npx tsc && node scripts/copy-provider-bundles.cjs && node -e \"require('node:fs').chmodSync('dist/index.js',0o755)\"",
    "test": "vitest run",
    "test:live-cursor": "vitest run --config vitest.live-cursor.config.ts",
    "lint": "npx tsc --noEmit",
    "build:capability-matrix": "node scripts/build-provider-capability-matrix.mjs",
    "prepublishOnly": "npm run build",
    "dev": "npx tsc --watch"
  },
  "dependencies": {
    "@clack/prompts": "^0.8.2",
    "@iarna/toml": "^2.2.5",
    "adm-zip": "^0.5.17",
    "diff": "^5.2.0",
    "js-yaml": "^4.1.0",
    "minimist": "^1.2.8",
    "picocolors": "^1.1.0",
    "semver": "^7.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/diff": "^5.2.1",
    "@types/js-yaml": "^4.0.9",
    "@types/minimist": "^1.2.5",
    "@types/node": "^20.14.0",
    "@types/semver": "^7.5.8",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT"
}
