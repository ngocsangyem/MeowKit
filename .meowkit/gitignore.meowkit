# MeowKit — append to your .gitignore
.env
.env.local

# `.meowkit/` holds project state. These classes are machine-written and either
# disposable or private. `.meowkit/config.json` and the team memory in
# `.meowkit/memory/` are meant to be committed, so the ignores are per-class
# rather than the whole dir.
.meowkit/telemetry/
.meowkit/state/
.meowkit/cache/

# Ephemeral per-session runtime state written by the SessionStart hooks.
session-state/

# Security Posture Reports and other run output under tasks/reports/ carry
# unpatched vulnerability detail, so they stay machine-local.
tasks/reports/

.claude/logs/
.claude/skills/.venv/
