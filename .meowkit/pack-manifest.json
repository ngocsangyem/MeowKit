{
  "schemaVersion": "1.0",
  "base": {
    "files": [
      "settings.json",
      "statusline.cjs",
      "harness-inventory.json",
      "pack-manifest.json",
      "gitignore.meowkit",
      "mcp.json.example",
      ".env.example",
      "rules/meowkit-core.md",
      "rules/security-rules.md",
      "rules/injection-rules.md",
      "rules/gate-rules.md",
      "rules/core-behaviors.md",
      "rules/development-rules.md",
      "rules/agent-conduct.md"
    ],
    "globs": [
      "hooks/**",
      "memory/**",
      "skills/help/**",
      "skills/lint-and-validate/**",
      "skills/plan-creator/**"
    ],
    "exclude": [
      ".claude/session-state/*",
      ".claude/memory/*",
      ".claude/logs/*",
      ".claude/skills/.venv/*",
      ".claude/worktrees/*",
      ".claude/metadata.json",
      ".claude/.env",
      ".meowkit/.env",
      ".meowkit/memory/*",
      ".meowkit/cache/*",
      ".meowkit/telemetry/*",
      ".meowkit/metadata.json",
      "*.pyc",
      "__pycache__/*",
      ".claude/settings.json.bak",
      ".claude/.brand-allowlist.txt",
      ".claude/agent-memory/*",
      ".claude/benchmarks/*",
      ".claude/skills/benchmark/*",
      ".claude/harness-substrate.md",
      ".claude/schemas/*",
      ".claude/eval/*",
      ".claude/skills/*/eval/*",
      ".claude/hooks/.logs/*",
      "*/.pytest_cache/*",
      "*/__tests__/*",
      "*/tests/*",
      "*.test.*"
    ]
  },
  "packs": {
    "lifecycle-core": {
      "owners": ["lifecycle"],
      "artifactsExclude": [
        "mk:autobuild",
        "mk:planning-engine",
        "mk:plan-ceo-review",
        "mk:story-sizer",
        "story-sizer",
        "mk:sprint-contract"
      ]
    },
    "testing": { "owners": ["testing"] },
    "git": { "owners": ["git"] },
    "docs": { "owners": ["docs"] },
    "memory": { "owners": ["memory"] },
    "research": { "owners": ["research"] },
    "portability": { "owners": ["portability"] },
    "observability": { "owners": ["observability"] },
    "utility": { "owners": ["utility"] },
    "security-audit": { "owners": ["security"] },
    "atlassian": { "owners": ["jira", "confluence"] },
    "product": {
      "artifactsAdd": [
        "mk:autobuild",
        "mk:planning-engine",
        "mk:plan-ceo-review",
        "mk:story-sizer",
        "story-sizer",
        "mk:sprint-contract",
        "mk:intake",
        "mk:office-hours"
      ]
    }
  },
  "profiles": {
    "core": ["base", "lifecycle-core", "memory", "utility"],
    "developer": ["core", "testing", "git", "docs"],
    "product": ["developer", "product"],
    "atlassian": ["developer", "atlassian"],
    "security": ["core", "security-audit"],
    "research": ["core", "research"],
    "full": ["*"]
  }
}
