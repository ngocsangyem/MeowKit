{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "MeowKit Design System",
    "version": "2.0.0",
    "mark": "Prompt + Cursor: ink > chevron, blue cat-eared cursor, lowercase mono wordmark meowkit",
    "theme": "light-first, night for dark mode",
    "updated": "2026-11-11",
    "canonical": "assets/design-tokens.json (mirrored byte-for-byte to docs/design/ and packages/mewkit/assets/)"
  },
  "color": {
    "base": {
      "paper":   { "$value": "#eef2f7", "$type": "color", "$description": "Mist paper. Page ground in light mode." },
      "surface": { "$value": "#e0e7f0", "$type": "color", "$description": "Cards, panels, secondary buttons." },
      "haze":    { "$value": "#c8d5e6", "$type": "color", "$description": "Lit frames, footer, hover fills." },
      "night":   { "$value": "#131a27", "$type": "color", "$description": "Ink, terminals, dark-mode ground." },
      "night-raised": { "$value": "#1b2435", "$type": "color", "$description": "Cards and panels on night." },
      "white":   { "$value": "#f7f9fc", "$type": "color", "$description": "Text on dusk blue." }
    },
    "accent": {
      "dusk": { "$value": "#2f66b3", "$type": "color", "$description": "The one accent on light grounds. 5.1:1 on paper: labels, links, fills, the mark. Never body text." },
      "sky":  { "$value": "#8fb5e8", "$type": "color", "$description": "The accent on night. 8.3:1 on night." }
    },
    "text": {
      "ink":        { "$value": "{color.base.night}", "$type": "color", "$description": "Body text on paper. 15.5:1." },
      "muted":      { "$value": "#566178", "$type": "color", "$description": "Secondary text on paper. 5.5:1." },
      "ink-dark":   { "$value": "{color.base.paper}", "$type": "color", "$description": "Body text on night. 15.5:1." },
      "muted-dark": { "$value": "#9aa6bb", "$type": "color", "$description": "Secondary text on night. 7.1:1." }
    },
    "line": {
      "light": { "$value": "rgb(19 26 39 / 0.13)", "$type": "color", "$description": "Hairlines on paper." },
      "dark":  { "$value": "rgb(238 242 247 / 0.12)", "$type": "color", "$description": "Hairlines on night." }
    },
    "signal": {
      "success":      { "$value": "#2f7a55", "$type": "color" },
      "warning":      { "$value": "#9a5d0c", "$type": "color" },
      "danger":       { "$value": "#b13f37", "$type": "color" },
      "success-dark": { "$value": "#7fc4a0", "$type": "color" },
      "warning-dark": { "$value": "#e3b46a", "$type": "color" },
      "danger-dark":  { "$value": "#ef9a90", "$type": "color" }
    }
  },
  "font": {
    "display": { "$value": "'Newsreader', 'Iowan Old Style', Georgia, serif", "$type": "fontFamily", "$description": "Headlines. Weight 400, optical size on." },
    "sans":    { "$value": "'Onest', system-ui, -apple-system, 'Segoe UI', sans-serif", "$type": "fontFamily", "$description": "Text and buttons. 400 and 500." },
    "mono":    { "$value": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace", "$type": "fontFamily", "$description": "Wordmark, commands, paths, counts, UI labels." },
    "code":    { "$value": "ui-monospace, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace", "$type": "fontFamily", "$description": "Docs code blocks. Platform mono only: a latin-subset webfont shears box-drawing diagrams." }
  },
  "type": {
    "display": { "$value": { "fontFamily": "{font.display}", "fontSize": "56px", "fontWeight": 400, "lineHeight": 1.04, "letterSpacing": "-0.024em" }, "$type": "typography" },
    "h2":      { "$value": { "fontFamily": "{font.display}", "fontSize": "40px", "fontWeight": 400, "lineHeight": 1.1,  "letterSpacing": "-0.02em" },  "$type": "typography" },
    "h3":      { "$value": { "fontFamily": "{font.sans}",    "fontSize": "20px", "fontWeight": 500, "lineHeight": 1.3,  "letterSpacing": "0" },        "$type": "typography" },
    "lede":    { "$value": { "fontFamily": "{font.sans}",    "fontSize": "20px", "fontWeight": 400, "lineHeight": 1.45, "letterSpacing": "0" },        "$type": "typography" },
    "body":    { "$value": { "fontFamily": "{font.sans}",    "fontSize": "16px", "fontWeight": 400, "lineHeight": 1.5,  "letterSpacing": "0" },        "$type": "typography" },
    "label":   { "$value": { "fontFamily": "{font.mono}",    "fontSize": "13px", "fontWeight": 500, "lineHeight": 1.4,  "letterSpacing": "0" },        "$type": "typography" },
    "code":    { "$value": { "fontFamily": "{font.mono}",    "fontSize": "14px", "fontWeight": 400, "lineHeight": 1.7,  "letterSpacing": "0" },        "$type": "typography" }
  },
  "radius": {
    "chip":   { "$value": "4px",  "$type": "dimension" },
    "card":   { "$value": "8px",  "$type": "dimension" },
    "button": { "$value": "99px", "$type": "dimension", "$description": "Buttons are pills." }
  },
  "space": {
    "1": { "$value": "4px",  "$type": "dimension" },
    "2": { "$value": "8px",  "$type": "dimension" },
    "3": { "$value": "12px", "$type": "dimension" },
    "4": { "$value": "16px", "$type": "dimension" },
    "6": { "$value": "24px", "$type": "dimension" },
    "8": { "$value": "32px", "$type": "dimension" },
    "12": { "$value": "48px", "$type": "dimension" },
    "16": { "$value": "64px", "$type": "dimension" },
    "24": { "$value": "96px", "$type": "dimension" }
  },
  "motion": {
    "ease":  { "$value": [0.2, 0.8, 0.2, 1], "$type": "cubicBezier" },
    "fast":  { "$value": "120ms", "$type": "duration" },
    "base":  { "$value": "240ms", "$type": "duration" },
    "blink": { "$value": "1100ms", "$type": "duration", "$description": "Cursor-cat blink period, stepped, no easing. Off under prefers-reduced-motion." }
  }
}
