#!/usr/bin/env bash
# setup-workflow — neutral wrapper for the installed setup command.
#
# Resolves the project's committed launcher first and the bare name second, so a project
# that has been installed into never depends on a package fetch to run its own setup.
set -euo pipefail
root="${CLAUDE_PROJECT_DIR:-$PWD}"
launcher="$root/.meowkit/bin/mewkit"
if [ -x "$launcher" ]; then
  exec "$launcher" setup "$@"
fi
exec mewkit setup "$@"
