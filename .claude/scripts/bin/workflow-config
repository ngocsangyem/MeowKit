#!/usr/bin/env node
'use strict';
// workflow-config — read a workflow setting, or record a per-project choice
// Usage:
//   workflow-config get <dotted.key> [default]
//   workflow-config set <dotted.key> <value>
//   workflow-config has <dotted.key>  → exit 0 if truthy, 1 if falsy/missing
//
// Runs on node so the skill preambles that call it work on a machine with no
// interpreter installed. `get` and `has` resolve session state, then the
// project config, then the user config, then the caller's default; `set` writes
// session state and never the committed config. The reasoning behind each
// answer lives in ../lib/workflow-config-core.cjs.

const C = require('../lib/workflow-config-core.cjs');

const USAGE = `workflow-config — read/write workflow config
Usage:
  workflow-config get <dotted.key> [default]
  workflow-config set <dotted.key> <value>
  workflow-config has <dotted.key>
Examples:
  workflow-config get features.costTracking
  workflow-config has features.memory && echo enabled
  workflow-config set mode.default strict
`;

/** `get` — print the value, else the default, else an empty line. Always exits 0. */
function get(key, fallback) {
  const { value, sourcePresent } = C.resolveKey(key);
  if (value === undefined && !sourcePresent) {
    // Nothing is configured at all. The caller's `|| echo "true"` default is
    // what should answer, so printing an empty line would answer for it.
    if (fallback) process.stdout.write(`${fallback}\n`);
    return 0;
  }
  process.stdout.write(`${value === undefined ? fallback || '' : C.render(value)}\n`);
  return 0;
}

/** `has` — exit 0 only when the value reads as switched on. */
function has(key) {
  const rendered = C.render(C.resolveKey(key).value);
  return rendered === 'true' || rendered === '1' || rendered === 'yes' ? 0 : 1;
}

/**
 * `set` — record the choice in session state.
 *
 * The committed config is human-owned: an agent that rewrote it mid-run would
 * put a settings change into the user's diff, which is also how a weakening
 * reaches a pull request. So the write lands in state, and the message says
 * where the same preference becomes durable — the behaviour change is visible
 * at the moment it matters rather than discovered from a diff later.
 */
function set(key, raw) {
  const file = C.statePath();
  const state = C.readJson(file) || {};
  C.assign(state, key, C.coerce(raw));
  try {
    C.writeState(file, state);
  } catch (err) {
    process.stderr.write(`Could not write ${C.displayPath(file)}: ${err.message}\n`);
    process.stderr.write('Fix: check the permissions on .meowkit/state/, then run this again\n');
    return 1;
  }
  process.stderr.write(`Set ${key} for this project in ${C.displayPath(file)} (session state).\n`);
  process.stderr.write('To make it durable for everyone, set it in .meowkit/config.yaml instead — state is not committed.\n');
  return 0;
}

function usage() {
  process.stdout.write(USAGE);
  return 1;
}

function main(argv) {
  const [subcommand, key, third] = argv;
  if (subcommand !== 'get' && subcommand !== 'set' && subcommand !== 'has') return usage();
  if (!key) {
    process.stderr.write(`Usage: workflow-config ${subcommand} <dotted.key>${subcommand === 'set' ? ' <value>' : ''}\n`);
    return 1;
  }

  if (subcommand === 'get') return get(key, third);
  if (subcommand === 'has') return has(key);
  if (third === undefined) {
    process.stderr.write('Usage: workflow-config set <dotted.key> <value>\n');
    return 1;
  }
  return set(key, third);
}

process.exit(main(process.argv.slice(2)));
