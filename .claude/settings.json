{
  "env": {
    "MEOWKIT_TDD": "0",
    "MEOWKIT_BUILD_VERIFY": "on",
    "MEOWKIT_LOOP_DETECT": "on",
    "MEOWKIT_PRECOMPLETION": "on",
    "MEOWKIT_TDD_FLAG_DETECTOR": "on",
    "MEOWKIT_MEMORY_BUDGET": "4000",
    "MEOWKIT_BUDGET_WARN": "30",
    "MEOWKIT_BUDGET_BLOCK": "100",
    "CLAUDE_CODE_FORK_SUBAGENT": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "node",
    "args": [
      "${CLAUDE_PROJECT_DIR}/.claude/statusline.cjs"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/ensure-skills-venv.sh\"",
            "timeout": 30,
            "statusMessage": "Ensuring Python skills venv..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dispatch.cjs",
              "SessionStart"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-enforcement.cjs"
            ],
            "timeout": 10,
            "statusMessage": "Checking Gate 1 approval..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/privacy-block.cjs"
            ],
            "timeout": 5,
            "statusMessage": "Checking file access permissions..."
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/privacy-block.cjs"
            ],
            "timeout": 5,
            "statusMessage": "Checking file access permissions..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-ship.cjs"
            ],
            "timeout": 30,
            "statusMessage": "Running pre-ship validation..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/privacy-block.cjs"
            ],
            "timeout": 5,
            "statusMessage": "Checking web fetch targets..."
          },
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dispatch.cjs",
              "PreToolUse",
              "Bash"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dispatch.cjs",
              "PostToolUse",
              "Edit|Write"
            ],
            "timeout": 40
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dispatch.cjs",
              "PostToolUse",
              "Bash"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dispatch.cjs",
              "Stop"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dispatch.cjs",
              "UserPromptSubmit"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [],
    "SubagentStop": [],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dispatch.cjs",
              "PreCompact"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/dispatch.cjs",
              "PostToolUseFailure"
            ],
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run lint)",
      "Bash(npx tsc --noEmit)",
      "Bash(python .claude/scripts/*)",
      "Bash(node .claude/hooks/*)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(wc -l *)",
      "Bash(ls *)",
      "Bash(find *)"
    ]
  }
}
