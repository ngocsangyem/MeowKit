{
  "name": "meowkit-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docs:build": "npm run build -w packages/docs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "npx prettier --write \"{src,tests}/**/*.ts\"",
    "format:check": "npx prettier --check \"{src,tests}/**/*.ts\"",
    "test": "vitest run",
    "release:check": "bash scripts/release-check.sh",
    "sync-versions": "node scripts/sync-versions.cjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^9.5.0",
    "globals": "^17.4.0",
    "js-yaml": "^5.5.0",
    "prettier": "^3.8.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.58.0",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.17.1",
  "license": "MIT",
  "version": "3.1.0",
  "overrides": {
    "npm": "^11.14.1"
  }
}
